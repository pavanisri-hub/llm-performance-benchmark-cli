# Optional Hugging Face access token.
# Required only for gated/private Hugging Face models.
# Never commit a real token. Create a local .env file from this template.
HF_TOKEN=

# Directory used by Hugging Face to cache downloaded models and tokenizers.
# Docker Compose maps this to a persistent project-local volume by default.
HF_HOME=/app/.cache/huggingface

# Optional explicit Transformers cache directory.
TRANSFORMERS_CACHE=/app/.cache/huggingface/hub

# Directory where CSV reports and PNG visualizations are saved.
BENCHMARK_OUTPUT_DIR=/app/outputs

# Logging level used by the CLI.
BENCHMARK_LOG_LEVEL=INFO